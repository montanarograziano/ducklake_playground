# Copy to .env and adjust if you want non-default credentials.
#
#   cp .env.example .env
#
# All variables here also have defaults baked into docker-compose.yml, so the stack runs
# fine without a .env file. Use .env when you want to override the defaults locally
# without committing changes.
#
# IMPORTANT: if you change any of these from the defaults, also update the matching
# section in `config.yaml` (the engine reads its connection details from there, not
# from the environment). Specifically:
#   POSTGRES_DB           → postgres.database in config.yaml
#   POSTGRES_USER         → postgres.user
#   POSTGRES_PASSWORD     → postgres.password
#   AWS_ACCESS_KEY_ID     → s3.access_key
#   AWS_SECRET_ACCESS_KEY → s3.secret_key

# ─── Postgres (DuckLake metadata catalog, always required) ────────────────────

POSTGRES_DB=ducklake_playground
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# ─── MinIO (only used when running the `s3` compose profile) ──────────────────

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=miniopassword
